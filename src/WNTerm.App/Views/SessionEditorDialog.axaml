<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WNTerm.App.Views.SessionEditorDialog"
             FontSize="12">

  <UserControl.Styles>
    <Style Selector="TextBlock.err">
      <Setter Property="Foreground" Value="#D92D20" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.tag">
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto">
    <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <StackPanel>
        <!-- Tên hiển thị + Tags (ẩn khi Kết nối nhanh) -->
        <StackPanel IsVisible="{Binding IsFullMode}">
        <TextBlock Text="{DynamicResource Str_EdName}" Margin="0,0,0,3" />
        <TextBox Text="{Binding Name}" Margin="0,0,0,6" />

        <TextBlock Text="{DynamicResource Str_TagsLabel}" Margin="0,0,0,3" />
        <TextBox Text="{Binding TagsText}" Margin="0,0,0,4" />
        <StackPanel x:Name="TagsPanel" Margin="0,0,0,6">
          <TextBlock Text="{DynamicResource Str_TagsHint}" FontSize="11" Classes="muted" Margin="0,0,0,2" />
          <ItemsControl x:Name="TagsList" ItemsSource="{Binding ExistingTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="tag" Content="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        </StackPanel>

        <!-- IP / Hostname -->
        <TextBlock Text="{DynamicResource Str_HostLabel}" Margin="0,0,0,3" FontWeight="SemiBold" />
        <TextBox Text="{Binding Host}" Margin="0,0,0,2" />
        <TextBlock Classes="err" Text="{Binding HostError}" Margin="0,0,0,6"
                   IsVisible="{Binding HostError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Port & User -->
        <Grid ColumnDefinitions="90,12,*" Margin="0,0,0,6">
          <StackPanel Grid.Column="0">
            <TextBlock Text="{DynamicResource Str_PortLabel}" Margin="0,0,0,3" FontWeight="SemiBold" />
            <TextBox x:Name="PortBox" Text="{Binding Port}" MaxLength="5" />
            <TextBlock Classes="err" Text="{Binding PortError}" Margin="0,2,0,0"
                       IsVisible="{Binding PortError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{DynamicResource Str_UserLabel}" Margin="0,0,0,3" FontWeight="SemiBold" />
            <TextBox Text="{Binding Username}" />
            <TextBlock Classes="err" Text="{Binding UsernameError}" Margin="0,2,0,0"
                       IsVisible="{Binding UsernameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>

        <Separator Margin="0,4,0,8" />
        <TextBlock Text="{DynamicResource Str_AuthLabel}" FontWeight="Bold" Margin="0,0,0,6" />

        <!-- Password -->
        <TextBlock Text="{DynamicResource Str_PasswordLabel}" Margin="0,0,0,3" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBox x:Name="PasswordBox" Grid.Column="0" PasswordChar="•" Text="{Binding Password}" />
          <Button x:Name="RevealBtn" Grid.Column="1" Width="36" MinHeight="0" Margin="4,0,0,0" Padding="0" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Path Classes="ico" Data="{StaticResource IconEye}" Width="16" Height="16" Stretch="Uniform" />
          </Button>
        </Grid>

        <!-- Hiển thị khi đang sửa và đã có mật khẩu lưu -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding HasStoredPassword}">
          <TextBlock Text="{DynamicResource Str_UsingSavedPassword}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
          <Button Content="{DynamicResource Str_ClearSavedPassword}" Command="{Binding ClearStoredPasswordActionCommand}"
                  Margin="8,0,0,0" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#D92D20" Padding="6,2" />
        </StackPanel>

        <CheckBox Content="{DynamicResource Str_SavePassword}" IsChecked="{Binding SavePassword}" Margin="0,0,0,6" IsVisible="{Binding IsFullMode}" />

        <!-- Key file -->
        <TextBlock Text="{DynamicResource Str_KeyFileLabel}" Margin="0,0,0,3" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBox Grid.Column="0" Text="{Binding KeyFilePath}" />
          <Button x:Name="BrowseBtn" Grid.Column="1" Content="{DynamicResource Str_EdBrowse}" Margin="4,0,0,0" Padding="10,4" />
        </Grid>
        <TextBlock Text="{Binding KeyFileWarning}" Foreground="#F79009" FontSize="11" Margin="0,0,0,6"
                   IsVisible="{Binding KeyFileWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Passphrase -->
        <TextBlock Text="{DynamicResource Str_EdPassphrase}" Margin="0,0,0,3" />
        <TextBox PasswordChar="•" Text="{Binding Passphrase}" Margin="0,0,0,6" />
      </StackPanel>
    </ScrollViewer>

    <!-- Nút hành động cố định ở đáy -->
    <Border Grid.Row="1" Padding="0,10,0,0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
      <WrapPanel>
        <Button Content="{DynamicResource Str_EdTest}" IsEnabled="{Binding CanTestConnection}" Padding="10,5"
                Command="{Binding TestConnectionCommand}" Margin="0,0,16,4" />
        <Button Content="{DynamicResource Str_SaveAndConnect}" Classes="primary" IsDefault="True" IsVisible="{Binding IsFullMode}"
                Command="{Binding SaveAndCloseCommand}" CommandParameter="{x:True}" Margin="0,0,6,4" />
        <Button Content="{DynamicResource Str_ConnectNow}" Classes="primary" IsDefault="True" IsVisible="{Binding QuickMode}"
                Command="{Binding SaveAndCloseCommand}" CommandParameter="{x:True}" Margin="0,0,6,4" />
        <Button Content="{DynamicResource Str_Save}" Command="{Binding SaveAndCloseCommand}" IsVisible="{Binding IsFullMode}"
                CommandParameter="{x:False}" Padding="12,5" Margin="0,0,6,4" FontWeight="SemiBold" />
        <Button Content="{DynamicResource Str_Cancel}" Command="{Binding CancelCommand}" Padding="12,5" Margin="0,0,0,4" Background="Transparent" />
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>
