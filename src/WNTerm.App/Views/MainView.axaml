<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WNTerm.ViewModels"
             xmlns:m="using:WNTerm.Models"
             xmlns:v="using:WNTerm.App.Views"
             xmlns:s="using:WNTerm.App.Services"
             x:Class="WNTerm.App.Views.MainView">

  <UserControl.Styles>
    <!-- Hàng VM: thông tin phụ ẩn khi rê chuột, thay bằng nút thao tác nhanh -->
    <Style Selector="ListBoxItem:pointerover StackPanel.rowinfo"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="StackPanel.quick"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.quick"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Button.qa">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Dòng header nhóm: không highlight như hàng thường -->
    <Style Selector="ListBoxItem.header">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem.header:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.tabclose">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="#8B949E" />
    </Style>
    <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4C5058" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.tabadd">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#C9D1D9" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tabadd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#32353A" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>
    <!-- ===== Chế độ gọn (điện thoại) ===== -->
    <Style Selector="Grid.compact Button.toolbar"><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Padding" Value="10,8" /></Style>
    <Style Selector="Grid.compact Button.toolbar TextBlock"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid.compact Button.toolbar StackPanel"><Setter Property="Spacing" Value="0" /></Style>
    <Style Selector="Grid.compact TabControl#LeftTabs /template/ ItemsPresenter#PART_ItemsPresenter"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundMuted}" />
    </Style>
    <Style Selector="Button.nav.active"><Setter Property="Foreground" Value="{DynamicResource ThemeConnectButtonBackground}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.key">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="2,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#2D3139" />
      <Setter Property="Foreground" Value="#E6EDF3" />
      <Setter Property="BorderBrush" Value="#3C3F41" />
    </Style>
    <Style Selector="ToggleButton.key:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ThemeConnectButtonBackground}" /></Style>
  </UserControl.Styles>

  <Grid>
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,26,Auto">

      <!-- ===== Thanh công cụ ===== -->
      <Border Grid.Row="0" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
        <DockPanel LastChildFill="True">
          <Border x:Name="Logo" DockPanel.Dock="Right" Background="White" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" Cursor="Hand" PointerPressed="OnLogoPressed"
                  ToolTip.Tip="WebNow - WN Term">
            <Image Source="avares://WNTerm.App/Assets/webnow-logo.png" Height="24" />
          </Border>
          <!-- Điện thoại: logo gọn (chữ N) ở góc phải thanh công cụ -->
          <Border x:Name="LogoCompact" DockPanel.Dock="Right" IsVisible="False" Background="White" CornerRadius="8" Cursor="Hand" PointerPressed="OnLogoPressed"
                  Padding="4" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="WebNow - WN Term">
            <Image Source="avares://WNTerm.App/Assets/favicon.png" Width="26" Height="26" />
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
              <Button Classes="primary toolbar" Command="{Binding AddVmCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico" Data="{StaticResource IconPlus}" />
                  <TextBlock Text="{DynamicResource Str_AddVm}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar" Command="{Binding SessionList.QuickConnectCommand}" ToolTip.Tip="{DynamicResource Str_QuickConnectTip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="fill" Data="{StaticResource IconPlay}" />
                  <TextBlock Text="{DynamicResource Str_QuickConnect}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ExportBtn" Classes="toolbar" Command="{Binding ExportCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico" Data="{StaticResource IconExport}" />
                  <TextBlock Text="{DynamicResource Str_Export}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ImportBtn" Classes="toolbar" Command="{Binding ImportCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico" Data="{StaticResource IconImport}" />
                  <TextBlock Text="{DynamicResource Str_Import}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar" Command="{Binding OpenCloudBackupCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico" Data="{StaticResource IconCloud}" Width="16" StrokeThickness="1.5" />
                  <TextBlock Text="Cloud" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar" Command="{Binding OpenPaletteCommand}" ToolTip.Tip="Ctrl+K">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico" Data="{StaticResource IconSearch}" />
                  <TextBlock Text="{DynamicResource Str_QuickFind}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar" Command="{Binding OpenSnippetsCommand}" ToolTip.Tip="Ctrl+Shift+S">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico" Data="{StaticResource IconSnippet}" />
                  <TextBlock x:Name="SnippetsToolbarText" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar" Command="{Binding OpenSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico" Data="{StaticResource IconSettings}" />
                  <TextBlock Text="{DynamicResource Str_Settings}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===== Nội dung chính: 2 cột ===== -->
      <Grid Grid.Row="1" x:Name="MainGrid" ColumnDefinitions="400,5,*">

        <!-- Cột trái: Sessions | SFTP -->
        <Border Grid.Column="0" x:Name="LeftPane" MinWidth="140" MaxWidth="600" Background="{DynamicResource ThemeSidebarBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,0">
          <TabControl x:Name="LeftTabs" SelectedIndex="{Binding SelectedLeftTabIndex, Mode=TwoWay}" Padding="0">
            <TabItem Header="{DynamicResource Str_Sessions}">
              <Grid Margin="6" RowDefinitions="Auto,Auto,*,Auto">

                <!-- Ô tìm kiếm -->
                <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding SessionList.SearchText, Mode=TwoWay}" VerticalContentAlignment="Center" />
                  <Button Grid.Column="1" Margin="6,0,0,0" Padding="9,0" Command="{Binding OpenPaletteCommand}" ToolTip.Tip="{DynamicResource Str_QuickFindTip}"
                          Foreground="{DynamicResource ThemeForegroundMuted}">
                    <TextBlock Text="Ctrl+K" FontSize="11" />
                  </Button>
                </Grid>

                <!-- Chip lọc tag -->
                <Grid Grid.Row="1" Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                  <WrapPanel Orientation="Horizontal">
                    <ToggleButton Classes="chip" Content="{DynamicResource Str_AllChip}" Command="{Binding SessionList.ClearTagFilterCommand}"
                                  IsChecked="{Binding SessionList.HasNoActiveTag, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{Binding SessionList.TagChips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagChip">
                          <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsActive, Mode=TwoWay}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </WrapPanel>
                  <ToggleButton Grid.Column="1" Classes="chip" Margin="4,0,0,4" Content="{DynamicResource Str_GroupChip}" ToolTip.Tip="{DynamicResource Str_GroupChipTip}"
                                IsChecked="{Binding SessionList.IsGrouped, Mode=TwoWay}" />
                </Grid>

                <!-- Danh sách VM -->
                <ListBox x:Name="SessionsListBox" Grid.Row="2" ItemsSource="{Binding SessionList.Rows}" SelectionMode="Multiple">
                  <ListBox.ContextMenu>
                    <ContextMenu x:Name="SessionMenu">
                      <MenuItem Header="{DynamicResource Str_ConnectMenu}" Click="ContextMenuConnect_Click" />
                      <MenuItem Header="{DynamicResource Str_EditVm}" Click="ContextMenuEdit_Click" InputGesture="F2" />
                      <MenuItem Header="{DynamicResource Str_PinToggle}" Click="ContextMenuPin_Click" />
                      <MenuItem Header="{DynamicResource Str_ExportVm}" Click="ContextMenuExport_Click" />
                      <Separator />
                      <MenuItem Header="{DynamicResource Str_Delete}" Click="ContextMenuDelete_Click" />
                    </ContextMenu>
                  </ListBox.ContextMenu>

                  <ListBox.DataTemplates>
                    <!-- Header nhóm -->
                    <DataTemplate DataType="vm:GroupHeaderRow">
                      <Border Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,1" Padding="8,5" Margin="0,4,0,0"
                              Cursor="Hand" Tag="{Binding}" PointerPressed="GroupHeader_PointerPressed">
                        <Grid ColumnDefinitions="16,*,Auto">
                          <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource ThemeForegroundMuted}" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Path.RenderTransform>
                              <RotateTransform Angle="{Binding IsCollapsed, Converter={x:Static s:Converters.CollapsedAngle}}" />
                            </Path.RenderTransform>
                          </Path>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource ThemeForegroundMuted}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>

                    <!-- Hàng VM -->
                    <DataTemplate DataType="m:SessionInfo">
                      <Grid Margin="2,1" Background="Transparent" ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{Binding TagsText}">
                        <!-- Icon máy chủ (màu theo kết nối) + chấm online -->
                        <Grid Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center">
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="14" Height="10" CornerRadius="1.5" BorderThickness="1.3" Background="Transparent"
                                    BorderBrush="{Binding LiveStatus, Converter={x:Static s:Converters.LiveStatusToIconBrush}}" />
                            <Rectangle Width="3" Height="2" HorizontalAlignment="Center" Fill="{Binding LiveStatus, Converter={x:Static s:Converters.LiveStatusToIconBrush}}" />
                            <Rectangle Width="9" Height="1.3" RadiusX="0.6" RadiusY="0.6" HorizontalAlignment="Center" Margin="0,1,0,0"
                                       Fill="{Binding LiveStatus, Converter={x:Static s:Converters.LiveStatusToIconBrush}}" />
                          </StackPanel>
                          <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" StrokeThickness="1.2"
                                   Fill="{Binding IsOnline, Converter={x:Static s:Converters.OnlineToBrush}}" Stroke="{DynamicResource ThemeSidebarBackground}" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPin}" Width="10" Height="10" Stretch="Uniform" Fill="#F5A623" Margin="0,0,4,0" VerticalAlignment="Center" IsVisible="{Binding IsPinned}" />
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource ThemeForegroundMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Ping + lần kết nối gần nhất (ẩn khi rê chuột) -->
                        <StackPanel Grid.Column="2" Classes="rowinfo" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                          <TextBlock Text="{Binding PingText}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeForegroundMuted}" />
                          <TextBlock Text="{Binding LastConnectedText}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeForegroundMuted}" Opacity="0.75" />
                        </StackPanel>

                        <!-- Thao tác nhanh khi rê chuột -->
                        <StackPanel Grid.Column="2" Classes="quick" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                          <Button Classes="qa" Click="QuickConnect_Click" ToolTip.Tip="{DynamicResource Str_QaConnect}"><Path Classes="fill" Data="{StaticResource IconPlay}" Width="11" Height="11" /></Button>
                          <Button Classes="qa" Click="QuickSftp_Click" ToolTip.Tip="{DynamicResource Str_QaSftp}"><Path Classes="ico" Data="{StaticResource IconFolder}" Width="13" Height="13" StrokeThickness="1.3" /></Button>
                          <Button Classes="qa" Click="QuickCopy_Click" ToolTip.Tip="{DynamicResource Str_QaCopy}"><Path Classes="ico" Data="{StaticResource IconCopy}" Width="13" Height="13" StrokeThickness="1.3" /></Button>
                          <Button Classes="qa" Click="QuickEdit_Click" ToolTip.Tip="{DynamicResource Str_QaEdit}"><Path Classes="ico" Data="{StaticResource IconEdit}" Width="13" Height="13" StrokeThickness="1.3" /></Button>
                        </StackPanel>

                        <Path Grid.Column="3" Data="{StaticResource IconWarning}" Width="13" Height="13" Stretch="Uniform" Fill="#F79009" Margin="4,0,0,0" VerticalAlignment="Center"
                              IsVisible="{Binding IsKeyFileMissing}" ToolTip.Tip="{DynamicResource Str_MissingKeyTooltip}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.DataTemplates>
                </ListBox>

                <!-- Chưa có VM -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False"
                            IsVisible="{Binding !SessionList.HasSessions}">
                  <TextBlock Text="{DynamicResource Str_NoVmsYet}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                  <TextBlock Text="{DynamicResource Str_ClickAddVm}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeForegroundMuted}" />
                </StackPanel>

                <!-- Thanh tóm tắt / thao tác theo ngữ cảnh -->
                <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,5" CornerRadius="6" Background="{DynamicResource ThemeToolbarBackground}">
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Command="{Binding SessionList.OpenTrashCommand}" Padding="6,1" Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0" ToolTip.Tip="{DynamicResource Str_TrashTip}"
                            IsVisible="{Binding SessionList.TrashCount, Converter={x:Static s:Converters.Positive}}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Classes="ico" Data="{StaticResource IconTrash}" Width="12" Height="12" />
                        <TextBlock Text="{Binding SessionList.TrashCount}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding SessionList.ConnectAllWithTagCommand}" Padding="8,1" FontSize="11"
                            IsVisible="{Binding SessionList.TagForGroupAction, Converter={x:Static s:Converters.NotEmpty}}">
                      <TextBlock FontSize="11">
                        <Run Text="{DynamicResource Str_OpenAllTag}" /><Run Text="{Binding SessionList.TagForGroupAction, Mode=OneWay}" FontWeight="SemiBold" />
                      </TextBlock>
                    </Button>
                    <TextBlock Text="{Binding SessionList.SummaryText}" FontSize="11" Foreground="{DynamicResource ThemeForegroundMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Border>
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Str_Sftp}">
              <Grid>
                <ContentControl x:Name="SftpHost" />
                <TextBlock x:Name="NoVmText" Text="{DynamicResource Str_NoVmConnected}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeForegroundMuted}" FontStyle="Italic" />
              </Grid>
            </TabItem>
          </TabControl>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorderBrush}" ResizeDirection="Columns" />

        <!-- Cột phải: dải tab + vùng terminal -->
        <Grid Grid.Column="2" x:Name="RightPane" RowDefinitions="36,*,Auto">
          <Border Grid.Row="0" Background="{DynamicResource ThemeTabStripBackground}" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <ItemsControl ItemsSource="{Binding Tabs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TerminalTabViewModel">
                      <Border Margin="2,0,2,0" Padding="10,6" CornerRadius="6,6,0,0" Cursor="Hand" Classes.selected="{Binding IsSelected}"
                              ToolTip.Tip="{Binding TooltipText}" PointerPressed="Tab_PointerPressed" Background="#32353A">
                        <Border.Styles>
                          <Style Selector="Border.selected">
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#3C3F41" />
                            <Setter Property="BorderThickness" Value="1,1,1,0" />
                          </Style>
                        </Border.Styles>
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{DynamicResource Str_Reconnect}" Command="{Binding ReconnectCommand}" />
                            <MenuItem Header="{DynamicResource Str_DuplicateTab}" Click="TabMenuDuplicate_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Str_CloseTab}" Click="TabMenuClose_Click" />
                            <MenuItem Header="{DynamicResource Str_CloseOtherTabs}" Click="TabMenuCloseOthers_Click" />
                            <MenuItem Header="{DynamicResource Str_CloseRightTabs}" Click="TabMenuCloseRight_Click" />
                            <MenuItem Header="{DynamicResource Str_CloseAllTabs}" Click="TabMenuCloseAll_Click" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                          <TextBlock Text="{Binding Title}" Foreground="#E6EDF3" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <Button Classes="tabclose" Click="TabClose_Click">
                            <Path Data="{StaticResource IconClose}" Width="8" Height="8" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="SnippetsTabBtn" Classes="tabadd" Margin="0,0,4,2" Command="{Binding OpenSnippetsCommand}" ToolTip.Tip="Snippets (Ctrl+Shift+S)">
                  <Path Data="{StaticResource IconSnippet}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" />
                </Button>
                <Button Classes="tabadd" Margin="4,0,4,2" Command="{Binding OpenVmListCommand}" ToolTip.Tip="{DynamicResource Str_OpenVmListTooltip}">
                  <Path Data="{StaticResource IconPlus}" Width="11" Height="11" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" />
                </Button>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Vùng terminal -->
          <Border Grid.Row="1" Background="{DynamicResource ThemeTerminalBackground}">
            <Grid>
              <Grid x:Name="TerminalContainerGrid" />
              <TextBlock x:Name="TerminalPlaceholder" Text="{DynamicResource Str_TerminalPlaceholder}" Foreground="#8B949E" FontStyle="Italic"
                         VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
          </Border>

          <!-- Hàng phím phụ cho điện thoại (Ctrl/Esc/Tab/mũi tên...) -->
          <Border Grid.Row="2" x:Name="KeyBar" IsVisible="False" Background="#16181A" BorderBrush="#2D3139" BorderThickness="0,1,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Margin="4,0">
                <Button x:Name="SnippetsKey" Classes="key" Click="SnippetsKey_Click" />
                <ToggleButton x:Name="CtrlKey" Classes="key" Content="Ctrl" Click="CtrlKey_Click" />
                <Button Classes="key" Content="Enter" Tag="ENTER" Click="Key_Click" />
                <Button Classes="key" Content="Esc" Tag="ESC" Click="Key_Click" />
                <Button Classes="key" Content="Tab" Tag="TAB" Click="Key_Click" />
                <Button Classes="key" Content="↑" Tag="UP" Click="Key_Click" />
                <Button Classes="key" Content="↓" Tag="DOWN" Click="Key_Click" />
                <Button Classes="key" Content="←" Tag="LEFT" Click="Key_Click" />
                <Button Classes="key" Content="→" Tag="RIGHT" Click="Key_Click" />
                <Button Classes="key" Content="Home" Tag="HOME" Click="Key_Click" />
                <Button Classes="key" Content="End" Tag="END" Click="Key_Click" />
                <Button Classes="key" Content="PgUp" Tag="PGUP" Click="Key_Click" />
                <Button Classes="key" Content="PgDn" Tag="PGDN" Click="Key_Click" />
                <Button Classes="key" Content="|" Tag="|" Click="Key_Click" />
                <Button Classes="key" Content="/" Tag="/" Click="Key_Click" />
                <Button Classes="key" Content="~" Tag="~" Click="Key_Click" />
                <Button Classes="key" Content="-" Tag="-" Click="Key_Click" />
                <Button Classes="key" Content="Ctrl+C" Tag="CTRLC" Click="Key_Click" />
                <Button Classes="key" Content="Paste" Tag="PASTE" Click="Key_Click" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <!-- ===== Thanh trạng thái ===== -->
      <Border Grid.Row="2" Background="{DynamicResource ThemeStatusBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <!-- Báo bản mới / tải bản cập nhật có tiến độ -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      DataContext="{Binding Update}" IsVisible="{Binding IsAvailable}">
            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource ThemeConnectButtonBackground}" VerticalAlignment="Center" />
            <ProgressBar Width="120" Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsDownloading}" VerticalAlignment="Center" />
            <Button Content="{Binding ButtonText}" Command="{Binding UpdateNowCommand}" IsVisible="{Binding !IsDownloading}"
                    Padding="10,0" MinHeight="0" Height="20" FontSize="11" VerticalContentAlignment="Center" />
            <Button Content="✕" Command="{Binding DismissCommand}" IsVisible="{Binding CanDismiss}"
                    Padding="6,0" MinHeight="0" Height="20" FontSize="11" VerticalContentAlignment="Center" Background="Transparent" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Điều hướng dưới (chỉ điện thoại) ===== -->
      <Border Grid.Row="3" x:Name="NavBar" IsVisible="False" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,*,*">
          <Button x:Name="NavSessions" Classes="nav" Content="Sessions" Click="NavSessions_Click" />
          <Button x:Name="NavTerminal" Grid.Column="1" Classes="nav" Content="Terminal" Click="NavTerminal_Click" />
          <Button x:Name="NavSftp" Grid.Column="2" Classes="nav" Content="SFTP" Click="NavSftp_Click" />
        </Grid>
      </Border>
    </Grid>

    <!-- Lớp phủ hộp thoại -->
    <Panel x:Name="Overlay" IsVisible="False" />
  </Grid>
</UserControl>
