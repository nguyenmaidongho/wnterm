<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Icon vector dùng chung (thay cho font Segoe MDL2 chỉ có trên Windows).
       Dùng: <PathIcon Data="{StaticResource IconPlay}" /> hoặc <Path Data=... Stroke=.../> theo ghi chú. Lưới 16x16. -->

  <!-- Nét đầy (Fill) -->
  <StreamGeometry x:Key="IconPlay">M 3 2 L 13 8 L 3 14 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPin">M8 1.2 L9.9 5.4 L14.4 5.9 L11 9 L12 13.5 L8 11.1 L4 13.5 L5 9 L1.6 5.9 L6.1 5.4 Z</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M 3 5.5 L 8 10.5 L 13 5.5 L 12 4.5 L 8 8.5 L 4 4.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconChevronRight">M 5.5 3 L 10.5 8 L 5.5 13 L 4.5 12 L 8.5 8 L 4.5 4 Z</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M 8 1.5 L 15 14 L 1 14 Z M 7.3 6 L 8.7 6 L 8.5 10.5 L 7.5 10.5 Z M 7.3 11.5 L 8.7 11.5 L 8.7 13 L 7.3 13 Z</StreamGeometry>

  <!-- Nét viền (dùng Stroke, StrokeThickness ~1.5, round caps) -->
  <StreamGeometry x:Key="IconPlus">M 8 2 L 8 14 M 2 8 L 14 8</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M 3.5 3.5 L 12.5 12.5 M 12.5 3.5 L 3.5 12.5</StreamGeometry>
  <StreamGeometry x:Key="IconExport">M 8 10 L 8 2 M 4.5 5.5 L 8 2 L 11.5 5.5 M 2.5 14 L 13.5 14</StreamGeometry>
  <StreamGeometry x:Key="IconImport">M 8 2 L 8 10 M 4.5 6.5 L 8 10 L 11.5 6.5 M 2.5 14 L 13.5 14</StreamGeometry>
  <StreamGeometry x:Key="IconCloud">M 4.5 13 A 3 3 0 0 1 4.5 7 A 4 4 0 0 1 12 6.5 A 3 3 0 0 1 12 13 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M 7 12 A 5 5 0 1 0 7 2 A 5 5 0 0 0 7 12 Z M 10.6 10.6 L 14.5 14.5</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M 1.5 4 L 14.5 4 M 1.5 8 L 14.5 8 M 1.5 12 L 14.5 12 M 9 2.5 L 9 5.5 M 5 6.5 L 5 9.5 M 11 10.5 L 11 13.5</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M 5.5 5.5 L 13.5 5.5 L 13.5 13.5 L 5.5 13.5 Z M 2.5 10.5 L 2.5 2.5 L 10.5 2.5</StreamGeometry>
  <StreamGeometry x:Key="IconEdit">M 2.5 13.5 L 3 10.5 L 11 2.5 L 13.5 5 L 5.5 13 Z M 9.5 4 L 12 6.5</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M 1.5 4 L 6 4 L 7.5 5.5 L 14.5 5.5 L 14.5 13 L 1.5 13 Z</StreamGeometry>
  <StreamGeometry x:Key="IconFile">M 3.5 1.5 L 9.5 1.5 L 12.5 4.5 L 12.5 14.5 L 3.5 14.5 Z M 9.5 1.5 L 9.5 4.5 L 12.5 4.5</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M 13 8 A 5 5 0 1 1 11.5 4.5 M 13 2.5 L 13 5.5 L 10 5.5</StreamGeometry>
  <StreamGeometry x:Key="IconUp">M 8 14 L 8 3 M 3.5 7 L 8 2.5 L 12.5 7</StreamGeometry>
  <StreamGeometry x:Key="IconDownload">M 8 2 L 8 11 M 4 7.5 L 8 11.5 L 12 7.5 M 2.5 14 L 13.5 14</StreamGeometry>
  <StreamGeometry x:Key="IconUpload">M 8 11.5 L 8 2.5 M 4 6.5 L 8 2.5 L 12 6.5 M 2.5 14 L 13.5 14</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M 2.5 4 L 13.5 4 M 6 4 L 6 2 L 10 2 L 10 4 M 4 4 L 4.8 14 L 11.2 14 L 12 4</StreamGeometry>
  <StreamGeometry x:Key="IconHome">M 2 8 L 8 2.5 L 14 8 M 3.5 7 L 3.5 13.5 L 12.5 13.5 L 12.5 7</StreamGeometry>
  <StreamGeometry x:Key="IconSnippet">M 6 2.5 C 4.5 2.5 4.5 4 4.5 5.5 C 4.5 7 3.5 8 2.5 8 C 3.5 8 4.5 9 4.5 10.5 C 4.5 12 4.5 13.5 6 13.5 M 10 2.5 C 11.5 2.5 11.5 4 11.5 5.5 C 11.5 7 12.5 8 13.5 8 C 12.5 8 11.5 9 11.5 10.5 C 11.5 12 11.5 13.5 10 13.5</StreamGeometry>
  <StreamGeometry x:Key="IconTerminal">M 2 3 L 14 3 L 14 13 L 2 13 Z M 4.5 6 L 7 8 L 4.5 10 M 8.5 10.5 L 11.5 10.5</StreamGeometry>
  <StreamGeometry x:Key="IconServer">M 2.5 3 L 13.5 3 L 13.5 7 L 2.5 7 Z M 2.5 9 L 13.5 9 L 13.5 13 L 2.5 13 Z M 4.5 5 L 4.5 5.01 M 4.5 11 L 4.5 11.01</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M 3 8.5 L 6.5 12 L 13 4.5</StreamGeometry>
  <StreamGeometry x:Key="IconKey">M 10 9.5 A 3.5 3.5 0 1 1 10 2.5 A 3.5 3.5 0 0 1 10 9.5 Z M 7.5 7.5 L 2 13 M 4 11 L 5.5 12.5</StreamGeometry>
  <StreamGeometry x:Key="IconNewFolder">M 1.5 4 L 6 4 L 7.5 5.5 L 14.5 5.5 L 14.5 13 L 1.5 13 Z M 8 7.5 L 8 11 M 6.3 9.25 L 9.7 9.25</StreamGeometry>
  <StreamGeometry x:Key="IconEye">M 1 8 C 3 4.5 5.5 3.5 8 3.5 C 10.5 3.5 13 4.5 15 8 C 13 11.5 10.5 12.5 8 12.5 C 5.5 12.5 3 11.5 1 8 Z M 8 10 A 2 2 0 1 0 8 6 A 2 2 0 0 0 8 10 Z</StreamGeometry>
</ResourceDictionary>
