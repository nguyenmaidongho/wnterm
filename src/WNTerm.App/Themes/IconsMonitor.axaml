  <StreamGeometry x:Key="MonUser">M 8 8 A 3 3 0 1 0 8 2 A 3 3 0 0 0 8 8 Z M 2.5 14.5 A 5.5 5 0 0 1 13.5 14.5</StreamGeometry>
