<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WNTerm.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WNTerm.App/Themes/Theme.axaml" />
        <ResourceInclude Source="avares://WNTerm.App/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://WNTerm.App/Themes/IconsMonitor.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://WNTerm.App/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
