<Window x:Class="SNTerm.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export danh sách VM"
        Width="500" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Chọn VM cần export:" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,8" />

        <!-- Danh sách checkbox VM -->
        <Border Grid.Row="1" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
            <ListBox x:Name="SessionsList" BorderThickness="0" Background="Transparent" SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#475467" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Nút chọn / bỏ chọn -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,12">
            <Button Content="Chọn tất cả" Click="SelectAll_Click" Padding="8,4" Margin="0,0,6,0" Background="#F2F4F7" BorderBrush="#D0D5DD" FontSize="11" />
            <Button Content="Bỏ chọn" Click="DeselectAll_Click" Padding="8,4" Background="#F2F4F7" BorderBrush="#D0D5DD" FontSize="11" />
        </StackPanel>

        <!-- Tùy chọn bảo mật -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Mật khẩu" FontWeight="Bold" Margin="0,0,0,6" Foreground="#1D2939" />
                <RadioButton x:Name="NoPasswordRadio" Content="Không kèm mật khẩu" IsChecked="True" Checked="PasswordMode_Changed" Margin="0,0,0,6" />
                <RadioButton x:Name="WithPasswordRadio" Content="Kèm mật khẩu, bảo vệ bằng mật khẩu Export" Checked="PasswordMode_Changed" Margin="0,0,0,8" />

                <StackPanel x:Name="PasswordFieldsPanel" IsEnabled="False" Margin="16,0,0,0">
                    <TextBlock Text="Mật khẩu Export (tối thiểu 8 ký tự):" FontSize="11" Margin="0,0,0,2" Foreground="#475467" />
                    <PasswordBox x:Name="ExportPasswordBox" Padding="6,4" Margin="0,0,0,6" />

                    <TextBlock Text="Nhập lại mật khẩu:" FontSize="11" Margin="0,0,0,2" Foreground="#475467" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="6,4" Margin="0,0,0,6" />

                    <CheckBox x:Name="IncludeKeyFileCheckBox" Content="Kèm nội dung file key" IsChecked="True" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Nút Export / Hủy -->
        <Border Grid.Row="4" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export..." Click="Export_Click" Padding="14,6" Margin="0,0,8,0" Background="#1570EF" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                <Button Content="Hủy" Click="Cancel_Click" Padding="14,6" Background="Transparent" BorderBrush="#D0D5DD" Cursor="Hand" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
