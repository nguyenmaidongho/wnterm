<Window x:Class="SNTerm.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập mật khẩu SSH"
        Width="440" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleBlock" Text="Nhập mật khẩu SSH" FontWeight="Bold" FontSize="15" Foreground="#101828" Margin="0,0,0,4" />
            <TextBlock x:Name="SubtitleBlock" Text="user@host:22" Foreground="#475467" />
            <TextBlock x:Name="WarningBlock" Text="Mật khẩu đã lưu không còn đúng, hãy nhập mật khẩu mới." Foreground="#D92D20" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Mật khẩu:" Margin="0,0,0,4" Foreground="#344054" />
            <PasswordBox x:Name="PasswordBoxControl" Padding="8,6" Margin="0,0,0,10" />
            <CheckBox x:Name="SavePasswordCheckBox" Content="Lưu lại cho lần sau" IsChecked="True" />
        </StackPanel>

        <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="#EAECF0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đăng nhập" Click="Login_Click" IsDefault="True" Padding="14,6" Margin="0,0,8,0" Background="#1570EF" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                <Button Content="Hủy" Click="Cancel_Click" IsCancel="True" Padding="14,6" Background="Transparent" BorderBrush="#D0D5DD" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
