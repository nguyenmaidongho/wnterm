<Window x:Class="SNTerm.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFF">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptBlock" Text="Nhập giá trị:" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#344054" />
        <TextBox x:Name="InputBox" Grid.Row="1" Padding="8,6" VerticalAlignment="Top" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Đồng ý" Click="Ok_Click" IsDefault="True" Padding="14,6" Margin="0,0,8,0" Background="#1570EF" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
            <Button Content="Hủy" Click="Cancel_Click" IsCancel="True" Padding="14,6" Background="Transparent" BorderBrush="#D0D5DD" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
