<Window x:Class="SNTerm.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/favicon.png"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ThemeWindowBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptBlock" Text="Nhập giá trị:" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}" />
        <TextBox x:Name="InputBox" Grid.Row="1" Padding="8,6" VerticalAlignment="Top" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" CaretBrush="{DynamicResource ThemeForeground}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Str_Ok}" Click="Ok_Click" IsDefault="True" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" IsCancel="True" Padding="14,6" Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>