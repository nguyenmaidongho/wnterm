<Window x:Class="SNTerm.Views.HostKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận Host Key"
        Icon="/Assets/favicon.png"
        Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ThemeWindowBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Warning -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleBlock" Text="Xác nhận kết nối tới máy chủ mới" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,6" />
            <Border x:Name="WarningBox" Background="#3D1A1A" BorderBrush="#F04438" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⚠ CẢNH BÁO: Khóa máy chủ đã thay đổi!" FontWeight="Bold" Foreground="#F04438" Margin="0,0,0,4" />
                    <TextBlock Text="Khóa của máy chủ này không khớp với khóa đã lưu. Có thể máy chủ đã được cài lại, hoặc ai đó đang cố gắng chặn kết nối của bạn." Foreground="#FECDCA" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Details -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeSidebarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Máy chủ:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" />
                    <TextBlock x:Name="HostBlock" Grid.Column="1" Text="10.0.0.5:22" Foreground="{DynamicResource ThemeForeground}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Thuật toán:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" />
                    <TextBlock x:Name="AlgorithmBlock" Grid.Column="1" Text="RSA" Foreground="{DynamicResource ThemeForeground}" />
                </Grid>

                <TextBlock Text="Fingerprint SHA256:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" Margin="0,4,0,4" />
                <TextBox x:Name="FingerprintBox" IsReadOnly="True" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" CaretBrush="{DynamicResource ThemeForeground}" Padding="6" FontFamily="Consolas, monospace" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TrustAndSaveButton" Content="Tin cậy &amp; Lưu" Click="TrustAndSave_Click" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
                <Button x:Name="TrustOnceButton" Content="Chỉ lần này" Click="TrustOnce_Click" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" />
                <Button x:Name="CancelButton" Content="Hủy" Click="Cancel_Click" Padding="14,6" Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>