<UserControl x:Class="SNTerm.Views.SftpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SNTerm.ViewModels"
             mc:Ignorable="d"
             FontFamily="Segoe UI" FontSize="12"
             Background="{DynamicResource ThemeWindowBackground}">

    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thanh nút công cụ SFTP -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Str_UpFolder}" Command="{Binding GoUpCommand}" Padding="6,2" Margin="2" ToolTip="{DynamicResource Str_UpFolderTooltip}" />
                <Button Content="⟳" Command="{Binding RefreshCommand}" Padding="6,2" Margin="2" ToolTip="{DynamicResource Str_RefreshTooltip}" />
                <Button Content="🏠" Command="{Binding GoHomeCommand}" Padding="6,2" Margin="2" ToolTip="{DynamicResource Str_HomeTooltip}" />
                <Button Content="{DynamicResource Str_NewFolderBtn}" Command="{Binding CreateDirectoryCommand}" Padding="6,2" Margin="2" />
                <Button Content="{DynamicResource Str_Upload}" Click="UploadButton_Click" Padding="6,2" Margin="2" />
                <Button Content="{DynamicResource Str_Download}" Click="DownloadButton_Click" Padding="6,2" Margin="2" />
                <Button Content="{DynamicResource Str_EditBtn}" Command="{Binding EditFileDefaultCommand}" Padding="6,2" Margin="2" ToolTip="{DynamicResource Str_EditDefaultTooltip}" />
                <CheckBox Content="{DynamicResource Str_ShowHiddenFilesShort}" IsChecked="{Binding ShowHiddenFiles}" Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
            </WrapPanel>
        </Border>

        <!-- Thanh đường dẫn -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
            <TextBox x:Name="PathTextBox" Text="{Binding CurrentPath, UpdateSourceTrigger=LostFocus}" KeyDown="PathTextBox_KeyDown" Padding="4,2"
                     Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" />
        </Border>

        <!-- Danh sách file/thư mục -->
        <Grid Grid.Row="2">
            <ListView x:Name="FileListView" ContextMenuOpening="FileListView_ContextMenuOpening"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Extended"
                      BorderThickness="0"
                      Background="{DynamicResource ThemeWindowBackground}"
                      Foreground="{DynamicResource ThemeForeground}"
                      MouseDoubleClick="FileListView_MouseDoubleClick" KeyDown="FileListView_KeyDown"
                      AllowDrop="True"
                      DragOver="FileListView_DragOver"
                      Drop="FileListView_Drop"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="4,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="2"
                                            SnapsToDevicePixels="True">
                                        <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeItemHover}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeItemSelected}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeItemHover}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource Str_ColName}" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 1. Parent Folder (Green with ..) -->
                                        <Viewbox x:Name="ParentFolderIcon" Width="16" Height="14" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="14">
                                                <Path Fill="#2E7D32" Data="M 1,2 L 6,2 L 7.5,4 L 14.5,4 C 15.3,4 15.5,4.5 15.5,5.2 L 15.5,12.5 C 15.5,13.2 15,13.8 14.2,13.8 L 1.8,13.8 C 1,13.8 0.5,13.2 0.5,12.5 L 0.5,3.3 C 0.5,2.6 1,2 1.8,2 Z" />
                                                <Path Fill="#4CAF50" Data="M 0.5,5.2 L 15.5,5.2 L 14.2,13.5 L 1.8,13.5 Z" />
                                                <Path Fill="#81C784" Data="M 1.5,5.5 L 14.5,5.5 L 13.8,6.8 L 2.2,6.8 Z" Opacity="0.7" />
                                                <Ellipse Fill="#FFFFFF" Canvas.Left="4.8" Canvas.Top="8.0" Width="2.4" Height="2.4" />
                                                <Ellipse Fill="#FFFFFF" Canvas.Left="8.8" Canvas.Top="8.0" Width="2.4" Height="2.4" />
                                            </Canvas>
                                        </Viewbox>

                                        <!-- 2. Regular Folder (Warm Amber) -->
                                        <Viewbox x:Name="FolderIcon" Width="16" Height="14" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="14">
                                                <Path Fill="#FFA000" Data="M 1,2 L 6,2 L 7.5,4 L 14.5,4 C 15.3,4 15.5,4.5 15.5,5.2 L 15.5,12.5 C 15.5,13.2 15,13.8 14.2,13.8 L 1.8,13.8 C 1,13.8 0.5,13.2 0.5,12.5 L 0.5,3.3 C 0.5,2.6 1,2 1.8,2 Z" />
                                                <Path Fill="#FFCA28" Data="M 0.5,5.2 L 15.5,5.2 L 14.2,13.5 L 1.8,13.5 Z" />
                                                <Path Fill="#FFE082" Data="M 1.5,5.5 L 14.5,5.5 L 13.8,6.8 L 2.2,6.8 Z" Opacity="0.8" />
                                            </Canvas>
                                        </Viewbox>

                                        <!-- 3. Symlink Folder (Warm Amber + Cyan link badge) -->
                                        <Viewbox x:Name="FolderSymlinkIcon" Width="16" Height="14" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="14">
                                                <Path Fill="#FFA000" Data="M 1,2 L 6,2 L 7.5,4 L 14.5,4 C 15.3,4 15.5,4.5 15.5,5.2 L 15.5,12.5 C 15.5,13.2 15,13.8 14.2,13.8 L 1.8,13.8 C 1,13.8 0.5,13.2 0.5,12.5 L 0.5,3.3 C 0.5,2.6 1,2 1.8,2 Z" />
                                                <Path Fill="#FFCA28" Data="M 0.5,5.2 L 15.5,5.2 L 14.2,13.5 L 1.8,13.5 Z" />
                                                <Path Fill="#FFE082" Data="M 1.5,5.5 L 14.5,5.5 L 13.8,6.8 L 2.2,6.8 Z" Opacity="0.8" />
                                                <Rectangle Canvas.Left="0" Canvas.Top="7" Width="7" Height="7" RadiusX="1" RadiusY="1" Fill="#0288D1" />
                                                <Path Fill="#FFFFFF" Data="M 1.5,11.5 L 3.8,9.2 L 3.8,10.5 C 5,10.5 6,11 6,13 C 5.5,12 4.8,11.7 3.8,11.7 L 3.8,13 Z" />
                                            </Canvas>
                                        </Viewbox>

                                        <!-- 4. Symlink File (Document + Cyan link badge) -->
                                        <Viewbox x:Name="FileSymlinkIcon" Width="16" Height="14" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="14">
                                                <Path Fill="#ECEFF1" Stroke="#78909C" StrokeThickness="0.8" Data="M 3,1 L 10,1 L 13,4 L 13,13 L 3,13 Z" />
                                                <Path Fill="#B0BEC5" Data="M 10,1 L 10,4 L 13,4 Z" />
                                                <Line X1="5" Y1="6" X2="11" Y2="6" Stroke="#90A4AE" StrokeThickness="0.8" />
                                                <Line X1="5" Y1="8" X2="11" Y2="8" Stroke="#90A4AE" StrokeThickness="0.8" />
                                                <Rectangle Canvas.Left="0" Canvas.Top="7" Width="7" Height="7" RadiusX="1" RadiusY="1" Fill="#0288D1" />
                                                <Path Fill="#FFFFFF" Data="M 1.5,11.5 L 3.8,9.2 L 3.8,10.5 C 5,10.5 6,11 6,13 C 5.5,12 4.8,11.7 3.8,11.7 L 3.8,13 Z" />
                                            </Canvas>
                                        </Viewbox>

                                        <!-- 5. Regular File (Document with folded corner) -->
                                        <Viewbox x:Name="FileIcon" Width="16" Height="14" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="14">
                                                <Path Fill="#ECEFF1" Stroke="#78909C" StrokeThickness="0.8" Data="M 3,1 L 10,1 L 13,4 L 13,13 L 3,13 Z" />
                                                <Path Fill="#B0BEC5" Data="M 10,1 L 10,4 L 13,4 Z" />
                                                <Line X1="5" Y1="6" X2="11" Y2="6" Stroke="#90A4AE" StrokeThickness="0.8" />
                                                <Line X1="5" Y1="8" X2="11" Y2="8" Stroke="#90A4AE" StrokeThickness="0.8" />
                                                <Line X1="5" Y1="10" X2="9" Y2="10" Stroke="#90A4AE" StrokeThickness="0.8" />
                                            </Canvas>
                                        </Viewbox>

                                        <TextBlock Text="{Binding Name}" FontWeight="Normal" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ItemType}" Value="ParentDirectory">
                                            <Setter TargetName="ParentFolderIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ItemType}" Value="Directory">
                                            <Setter TargetName="FolderIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ItemType}" Value="DirectorySymlink">
                                            <Setter TargetName="FolderSymlinkIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ItemType}" Value="FileSymlink">
                                            <Setter TargetName="FileSymlinkIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ItemType}" Value="File">
                                            <Setter TargetName="FileIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Str_ColSize}" DisplayMemberBinding="{Binding SizeFormatted}" Width="65" />
                        <GridViewColumn Header="{DynamicResource Str_ColPermissions}" DisplayMemberBinding="{Binding Permissions}" Width="95" />
                        <GridViewColumn Header="{DynamicResource Str_ColOwner}" DisplayMemberBinding="{Binding Owner}" Width="65" />
                        <GridViewColumn Header="{DynamicResource Str_ColGroup}" DisplayMemberBinding="{Binding Group}" Width="65" />
                        <GridViewColumn Header="{DynamicResource Str_ColModified}" DisplayMemberBinding="{Binding LastModifiedFormatted}" Width="105" />
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Str_EditFileDefault}" Command="{Binding EditFileDefaultCommand}" />
                        <MenuItem Header="{DynamicResource Str_EditFileWith}" Command="{Binding EditFileWithAppCommand}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Str_Download}" Click="DownloadButton_Click" />
                        <MenuItem Header="{DynamicResource Str_Rename}" Command="{Binding RenameItemCommand}" />
                        <MenuItem Header="{DynamicResource Str_Chmod}" Click="ChmodMenuItem_Click" />
                        <MenuItem Header="{DynamicResource Str_Delete}" Click="ContextMenuDelete_Click" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Str_NewDirectory}" Command="{Binding CreateDirectoryCommand}" />
                        <MenuItem Header="{DynamicResource Str_Refresh}" Command="{Binding RefreshCommand}" />
                        <MenuItem Header="{DynamicResource Str_CopyPath}" Click="CopyPath_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Loading overlay -->
            <Border Background="{DynamicResource ThemeCardBackground}" Opacity="0.8" Visibility="{Binding IsLoading, Converter={x:Static vm:SessionListViewModel.BoolToVisibilityConverter}}">
                <TextBlock Text="{DynamicResource Str_Loading}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundMuted}" FontStyle="Italic" />
            </Border>
        </Grid>

        <!-- Thanh tiến trình Upload/Download -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="6,4"
                Visibility="{Binding TransferQueue.IsTransferring, Converter={x:Static vm:SessionListViewModel.BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding TransferQueue.CurrentFileName}" Foreground="{DynamicResource ThemeForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    <TextBlock Text="{Binding TransferQueue.SpeedFormatted, StringFormat=' ({0})'}" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="11" Margin="4,0,0,0" />
                </StackPanel>

                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="{DynamicResource Str_Cancel}" Command="{Binding TransferQueue.CancelCommand}" Padding="8,2" FontSize="11" VerticalAlignment="Center" />

                <ProgressBar Grid.Row="1" Grid.Column="0" Value="{Binding TransferQueue.ProgressPercentage}" Height="6" Margin="0,4,8,0" Maximum="100" />
            </Grid>
        </Border>
    </Grid>
</UserControl>