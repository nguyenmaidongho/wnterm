<Window x:Class="SNTerm.Views.ChmodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_ChmodTitle}"
        Icon="/Assets/favicon.png"
        Width="380" Height="410"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ThemeWindowBackground}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tên mục -->
        <TextBlock x:Name="TargetBlock" Grid.Row="0" Text="Item: " FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />

        <!-- Bảng 9 checkbox phân quyền -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Subject}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str_Read}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Str_Write}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Str_Execute}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Chủ sở hữu (Owner) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_OwnerSubject}" Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkOwnerR" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkOwnerW" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkOwnerX" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Nhóm (Group) -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_GroupSubject}" Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkGroupR" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkGroupW" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkGroupX" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Khác (Others) -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_OthersSubject}" Foreground="{DynamicResource ThemeForeground}" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkOthersR" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkOthersW" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkOthersX" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Nhập số Octal -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Str_OctalLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}" />
            <TextBox x:Name="OctalBox" Grid.Column="1" Width="70" Padding="6,4" TextAlignment="Center" FontWeight="Bold" FontSize="14"
                     Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}"
                     BorderBrush="{DynamicResource ThemeBorderBrush}" CaretBrush="{DynamicResource ThemeForeground}" />
        </Grid>

        <!-- Tùy chọn đệ quy -->
        <CheckBox x:Name="RecursiveCheckBox" Grid.Row="3" Content="{DynamicResource Str_RecursiveLabel}"
                  Margin="0,0,0,12" Visibility="Collapsed" />

        <!-- Nút bấm -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Str_Save}" Click="Ok_Click" IsDefault="True" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" IsCancel="True" Padding="14,6"
                    Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
