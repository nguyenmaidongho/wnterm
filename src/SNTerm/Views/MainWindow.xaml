<Window x:Class="SNTerm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SNTerm.ViewModels"
        xmlns:localViews="clr-namespace:SNTerm.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Segoe UI" FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="ToolbarBackground" Color="#F8F9FA" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TerminalBackground" Color="#1E1E1E" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Thanh công cụ phía trên -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Thêm VM" Command="{Binding AddVmCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="⇪ Export" Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="⇩ Import" Command="{Binding ImportCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="⚙ Cài đặt" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- Nội dung chính 2 cột chia bằng GridSplitter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftColumnWidth, Mode=TwoWay}" MinWidth="180" MaxWidth="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: TabControl Sessions / SFTP -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectedIndex="{Binding SelectedLeftTabIndex}" BorderThickness="0" Background="Transparent">
                    <!-- Tab Sessions -->
                    <TabItem Header="Sessions" FontWeight="SemiBold">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Ô tìm kiếm -->
                            <TextBox Grid.Row="0" Margin="0,0,0,8" Padding="6,4"
                                     Text="{Binding SessionList.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Danh sách VM gom nhóm -->
                            <ListBox x:Name="SessionsListBox" Grid.Row="1"
                                     ItemsSource="{Binding SessionList.SessionsView}"
                                     SelectedItem="{Binding SessionList.SelectedSession}"
                                     SelectionMode="Extended"
                                     BorderThickness="0" Background="Transparent"
                                     MouseDoubleClick="SessionsListBox_MouseDoubleClick"
                                     KeyDown="SessionsListBox_KeyDown">

                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander IsExpanded="True" Header="{Binding Name}" FontWeight="Bold" Margin="0,2,0,6">
                                                                <ItemsPresenter Margin="12,2,0,0" />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent" SnapsToDevicePixels="true">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F2F4F7" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EBF3FF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#101828" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#475467" />
                                            </StackPanel>

                                            <!-- Biểu tượng cảnh báo thiếu file key -->
                                            <TextBlock Grid.Column="1" Text="⚠" Foreground="#F79009" FontWeight="Bold" ToolTip="Không tìm thấy file key"
                                                       Visibility="{Binding IsKeyFileMissing, Converter={x:Static vm:SessionListViewModel.BoolToVisibilityConverter}}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Kết nối" Command="{Binding SessionList.ConnectCommand}" />
                                        <MenuItem Header="Sửa" Command="{Binding SessionList.EditSessionCommand}" />
                                        <MenuItem Header="Nhân bản" Command="{Binding SessionList.DuplicateSessionCommand}" />
                                        <MenuItem Header="Export VM này..." Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Separator />
                                        <MenuItem Header="Xóa" Click="ContextMenuDelete_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Tab SFTP -->
                    <TabItem Header="SFTP" FontWeight="SemiBold">
                        <Grid>
                            <ContentControl Content="{Binding CurrentSftp}">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:SftpViewModel}">
                                        <localViews:SftpPanel />
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>

                            <TextBlock Text="Chưa kết nối VM nào" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A2B3" FontStyle="Italic"
                                       Visibility="{Binding CurrentSftp, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSftp}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Thanh chia cột có thể kéo thả -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE" ShowsPreview="True" />

            <!-- Cột phải: Thanh tab ngang và vùng Terminal -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Thanh tab ngang phía trên -->
                <Border Grid.Row="0" Background="#2B2D30" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TabBorder" Margin="2,0,2,0" Padding="10,6" CornerRadius="4,4,0,0"
                                                    Cursor="Hand" ToolTip="{Binding TooltipText}"
                                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                                    MouseDown="Tab_MouseDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#32353A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1E1E1E" />
                                                                <Setter Property="BorderBrush" Value="#3C3F41" />
                                                                <Setter Property="BorderThickness" Value="1,1,1,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="● " Foreground="{Binding StatusBrush}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Title}" Foreground="#E6EDF3" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <Button Content="×" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="#8B949E" Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                                </StackPanel>

                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Kết nối lại" Command="{Binding ReconnectCommand}" />
                                                        <MenuItem Header="Nhân bản tab" Command="{Binding DataContext.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="Đóng tab" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="Đóng các tab khác" Command="{Binding DataContext.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="Đóng các tab bên phải" Command="{Binding DataContext.CloseRightTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="Đóng tất cả" Command="{Binding DataContext.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Nút thêm tab [+] -->
                                <Button Content="+" Command="{Binding AddVmCommand}" Width="28" Height="28" Margin="4,0,4,2" Background="Transparent" Foreground="#C9D1D9" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" ToolTip="Mở danh sách VM" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Vùng chứa Terminal (xterm.js WebView2) -->
                <Border Grid.Row="1" Background="{StaticResource TerminalBackground}">
                    <Grid>
                        <!-- Container cho các WebView2 của các tab -->
                        <Grid x:Name="TerminalContainerGrid" />

                        <!-- Placeholder khi chưa có tab nào -->
                        <TextBlock Text="Chọn hoặc nhấp đúp vào một VM ở danh sách bên trái để kết nối terminal..."
                                   Foreground="#8B949E" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding Tabs.Count, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Thanh trạng thái phía dưới -->
        <Border Grid.Row="2" Background="#F2F4F7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#475467" FontSize="12" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>





