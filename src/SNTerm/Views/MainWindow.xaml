<Window x:Class="SNTerm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SNTerm.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="ToolbarBackground" Color="#F8F9FA" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TerminalBackground" Color="#1E1E1E" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Thanh công cụ phía trên -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Thêm VM" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="⇪ Export" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="⇩ Import" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="⚙ Cài đặt" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- Nội dung chính 2 cột chia bằng GridSplitter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: TabControl Sessions / SFTP -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <TabControl BorderThickness="0" Background="Transparent">
                    <!-- Tab Sessions -->
                    <TabItem Header="Sessions" FontWeight="SemiBold">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Ô tìm kiếm -->
                            <TextBox Grid.Row="0" Margin="0,0,0,8" Padding="6,4" Text="🔍 Tìm VM..." Foreground="#667085" />

                            <!-- Danh sách VM mẫu theo nhóm -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Nhóm Dev -->
                                    <Expander Header="▾ Dev" IsExpanded="True" FontWeight="Bold" Margin="0,0,0,4">
                                        <StackPanel Margin="16,4,0,0" >
                                            <Border Padding="6,4" Background="#EBF3FF" CornerRadius="4" Margin="0,2">
                                                <StackPanel>
                                                    <TextBlock Text="web-01" FontWeight="SemiBold" Foreground="#101828" />
                                                    <TextBlock Text="ubuntu@10.0.0.5:22" FontSize="11" Foreground="#475467" />
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="6,4" Margin="0,2">
                                                <StackPanel>
                                                    <TextBlock Text="db-02" FontWeight="SemiBold" Foreground="#101828" />
                                                    <TextBlock Text="root@10.0.0.6:22" FontSize="11" Foreground="#475467" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Nhóm Prod -->
                                    <Expander Header="▾ Prod" IsExpanded="True" FontWeight="Bold" Margin="0,4,0,4">
                                        <StackPanel Margin="16,4,0,0" >
                                            <Border Padding="6,4" Margin="0,2">
                                                <StackPanel>
                                                    <TextBlock Text="api-01" FontWeight="SemiBold" Foreground="#101828" />
                                                    <TextBlock Text="deploy@api.example.com:2222" FontSize="11" Foreground="#475467" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab SFTP -->
                    <TabItem Header="SFTP" FontWeight="SemiBold">
                        <Grid Margin="10">
                            <TextBlock Text="Chưa kết nối VM nào" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A2B3" FontStyle="Italic" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Thanh chia cột có thể kéo thả -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE" ShowsPreview="True" />

            <!-- Cột phải: Thanh tab ngang và vùng Terminal -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Thanh tab ngang phía trên -->
                <Border Grid.Row="0" Background="#2B2D30" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <!-- Tab active: web-01 -->
                            <Border Background="#1E1E1E" CornerRadius="4,4,0,0" Padding="12,6" Margin="4,0,2,0" BorderBrush="#3C3F41" BorderThickness="1,1,1,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="● " Foreground="#52C41A" FontWeight="Bold" ToolTip="Đã kết nối" />
                                    <TextBlock Text="web-01" Foreground="#E6EDF3" FontWeight="SemiBold" ToolTip="ubuntu@10.0.0.5:22" />
                                    <Button Content="×" Margin="8,0,0,0" Foreground="#8B949E" Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Tab phụ: db-02 -->
                            <Border Background="#32353A" CornerRadius="4,4,0,0" Padding="12,6" Margin="2,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="● " Foreground="#52C41A" FontWeight="Bold" ToolTip="Đã kết nối" />
                                    <TextBlock Text="db-02" Foreground="#C9D1D9" ToolTip="root@10.0.0.6:22" />
                                    <Button Content="×" Margin="8,0,0,0" Foreground="#8B949E" Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Nút thêm tab [+] -->
                            <Button Content="+" Width="28" Height="28" Margin="4,0,4,2" Background="Transparent" Foreground="#C9D1D9" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" ToolTip="Mở danh sách VM" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Vùng chứa Terminal (xterm.js layout) -->
                <Border Grid.Row="1" Background="{StaticResource TerminalBackground}" Padding="8">
                    <Grid>
                        <TextBlock Text="ubuntu@web-01:~$ ls -la&#x0a;total 24&#x0a;drwxr-xr-x 4 ubuntu ubuntu 4096 Sep 28 10:00 .&#x0a;drwxr-xr-x 3 root   root   4096 Sep 28 09:30 ..&#x0a;-rw-r--r-- 1 ubuntu ubuntu  220 Sep 28 09:30 .bash_logout&#x0a;-rw-r--r-- 1 ubuntu ubuntu 3771 Sep 28 09:30 .bashrc&#x0a;ubuntu@web-01:~$ █"
                                   Foreground="#CCCCCC" FontFamily="'JetBrains Mono', Consolas, monospace" FontSize="13" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Thanh trạng thái phía dưới -->
        <Border Grid.Row="2" Background="#F2F4F7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#475467" FontSize="12" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>

