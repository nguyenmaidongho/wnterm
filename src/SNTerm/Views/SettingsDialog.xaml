<Window x:Class="SNTerm.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt SN Term"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Giao diện &amp; Terminal" FontWeight="Bold" FontSize="14" Foreground="#101828" Margin="0,0,0,12" />

                <!-- Font -->
                <TextBlock Text="Font terminal:" Foreground="#344054" Margin="0,0,0,4" />
                <ComboBox x:Name="FontFamilyCombo" Padding="6,4" Margin="0,0,0,12">
                    <ComboBoxItem Content="JetBrains Mono" IsSelected="True" />
                    <ComboBoxItem Content="Cascadia Mono" />
                    <ComboBoxItem Content="Consolas" />
                </ComboBox>

                <!-- Font size -->
                <TextBlock Text="Cỡ chữ terminal:" Foreground="#344054" Margin="0,0,0,4" />
                <ComboBox x:Name="FontSizeCombo" Padding="6,4" Margin="0,0,0,12">
                    <ComboBoxItem Content="11" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="13" />
                    <ComboBoxItem Content="14" IsSelected="True" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="20" />
                </ComboBox>

                <!-- Theme -->
                <TextBlock Text="Chủ đề (Theme):" Foreground="#344054" Margin="0,0,0,4" />
                <ComboBox x:Name="ThemeCombo" Padding="6,4" Margin="0,0,0,16">
                    <ComboBoxItem Content="Dark" IsSelected="True" />
                    <ComboBoxItem Content="Light" />
                </ComboBox>

                <Separator Margin="0,4,0,12" Background="#E4E7EC" />
                <TextBlock Text="Thao tác &amp; Clipboard" FontWeight="Bold" FontSize="14" Foreground="#101828" Margin="0,0,0,12" />

                <!-- Copy on select -->
                <CheckBox x:Name="CopyOnSelectCheck" Content="Quét khối (bôi đen) là tự động copy" IsChecked="True" Margin="0,0,0,8" />

                <!-- Right click -->
                <TextBlock Text="Hành động khi nhấp chuột phải trong terminal:" Foreground="#344054" Margin="0,4,0,4" />
                <ComboBox x:Name="RightClickCombo" Padding="6,4" Margin="0,0,0,12">
                    <ComboBoxItem Content="Dán clipboard (Shift + chuột phải để hiện menu)" IsSelected="True" Tag="Paste" />
                    <ComboBoxItem Content="Hiện menu (Shift + chuột phải để dán)" Tag="Menu" />
                </ComboBox>

                <!-- Confirm multiline paste -->
                <CheckBox x:Name="ConfirmMultilineCheck" Content="Hỏi xác nhận khi dán nội dung có nhiều dòng" IsChecked="True" Margin="0,0,0,12" />

                <Separator Margin="0,4,0,12" Background="#E4E7EC" />
                <TextBlock Text="Mạng &amp; SFTP" FontWeight="Bold" FontSize="14" Foreground="#101828" Margin="0,0,0,12" />

                <!-- Keepalive -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Thời gian gửi Keep-Alive (giây):" VerticalAlignment="Center" Foreground="#344054" />
                    <TextBox x:Name="KeepAliveBox" Grid.Column="1" Text="30" Padding="6,4" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="1" Padding="0,16,0,0" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu cài đặt" Click="Save_Click" IsDefault="True" Padding="14,6" Margin="0,0,8,0" Background="#1570EF" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                <Button Content="Hủy" Click="Cancel_Click" IsCancel="True" Padding="14,6" Background="Transparent" BorderBrush="#D0D5DD" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
