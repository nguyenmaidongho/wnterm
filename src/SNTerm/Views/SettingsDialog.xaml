<Window x:Class="SNTerm.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_SettingsTitle}"
        Icon="/Assets/favicon.png"
        Width="540" Height="730" MinWidth="480" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource ThemeWindowBackground}">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_AppearanceTerminal}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,10" />

                <!-- Language -->
                <TextBlock Text="{DynamicResource Str_LanguageLabel}" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" />
                <ComboBox x:Name="LanguageCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="English (Default)" Tag="en" />
                    <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                </ComboBox>

                <!-- Font -->
                <TextBlock Text="{DynamicResource Str_FontLabel}" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" />
                <ComboBox x:Name="FontFamilyCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="JetBrains Mono" IsSelected="True" />
                    <ComboBoxItem Content="Cascadia Mono" />
                    <ComboBoxItem Content="Consolas" />
                </ComboBox>

                <!-- Font size -->
                <TextBlock Text="{DynamicResource Str_FontSizeLabel}" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" />
                <ComboBox x:Name="FontSizeCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="11" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="13" />
                    <ComboBoxItem Content="14" IsSelected="True" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="20" />
                </ComboBox>

                <!-- Theme -->
                <TextBlock Text="{DynamicResource Str_ThemeLabel}" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" />
                <ComboBox x:Name="ThemeCombo" Margin="0,0,0,14">
                    <ComboBoxItem Content="Dark" IsSelected="True" />
                    <ComboBoxItem Content="Light" />
                </ComboBox>

                <Separator Margin="0,2,0,10" Background="{DynamicResource ThemeBorderBrush}" />
                <TextBlock Text="{DynamicResource Str_ActionsClipboard}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,10" />

                <!-- Copy on select -->
                <CheckBox x:Name="CopyOnSelectCheck" Content="{DynamicResource Str_CopyOnSelect}" IsChecked="True" Margin="0,0,0,8" />

                <!-- Right click -->
                <TextBlock Text="{DynamicResource Str_RightClickLabel}" Foreground="{DynamicResource ThemeForeground}" Margin="0,2,0,4" />
                <ComboBox x:Name="RightClickCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="{DynamicResource Str_RightClickPaste}" IsSelected="True" Tag="Paste" />
                    <ComboBoxItem Content="{DynamicResource Str_RightClickMenu}" Tag="Menu" />
                </ComboBox>

                <!-- Confirm multiline paste -->
                <CheckBox x:Name="ConfirmMultilineCheck" Content="{DynamicResource Str_ConfirmMultiline}" IsChecked="True" Margin="0,0,0,12" />

                <Separator Margin="0,2,0,10" Background="{DynamicResource ThemeBorderBrush}" />
                <TextBlock Text="{DynamicResource Str_NetworkSftp}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,10" />

                <!-- SFTP Show hidden files -->
                <CheckBox x:Name="ShowHiddenFilesCheck" Content="{DynamicResource Str_ShowHiddenFiles}" IsChecked="True" Margin="0,0,0,10" />

                <!-- Custom Editor -->
                <TextBlock Text="{DynamicResource Str_CustomEditorLabel}" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomEditorBox" Grid.Column="0" />
                    <Button Grid.Column="1" Content="{DynamicResource Str_BrowseBtn}" Margin="4,0,0,0" Padding="10,4" Click="BrowseEditor_Click"
                            Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>

                <!-- Keepalive -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_KeepAliveLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground}" />
                    <TextBox x:Name="KeepAliveBox" Grid.Column="1" Text="30" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="1" Padding="0,12,0,0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str_SaveSettings}" Click="Save_Click" IsDefault="True" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" IsCancel="True" Padding="14,5"
                        Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
