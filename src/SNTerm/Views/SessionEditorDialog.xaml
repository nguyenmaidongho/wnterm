<Window x:Class="SNTerm.Views.SessionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SNTerm.ViewModels"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Icon="/Assets/favicon.png"
        Width="500" Height="560" MinWidth="440" MinHeight="400"
        
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource ThemeWindowBackground}">



    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Tên hiển thị -->
                <TextBlock Text="Tên hiển thị (tùy chọn):" Margin="0,0,0,3" Foreground="{DynamicResource ThemeForeground}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                <!-- IP / Hostname -->
                <TextBlock Text="{DynamicResource Str_HostLabel}" Margin="0,0,0,3" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding HostError}" Foreground="#D92D20" FontSize="11" Margin="0,0,0,6"
                           Visibility="{Binding HostError, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}" />

                <!-- Port & User -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_PortLabel}" Margin="0,0,0,3" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                 PreviewTextInput="PortTextBox_PreviewTextInput"
                                 DataObject.Pasting="PortTextBox_Pasting"
                                 GotFocus="SelectAllOnFocus_GotFocus"
                                 PreviewMouseLeftButtonDown="SelectAllOnFocus_PreviewMouseLeftButtonDown" />
                        <TextBlock Text="{Binding PortError}" Foreground="#D92D20" FontSize="11" Margin="0,2,0,0"
                                   Visibility="{Binding PortError, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Str_UserLabel}" Margin="0,0,0,3" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding UsernameError}" Foreground="#D92D20" FontSize="11" Margin="0,2,0,0"
                                   Visibility="{Binding UsernameError, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,4,0,8" Background="{DynamicResource ThemeBorderBrush}" />
                <TextBlock Text="{DynamicResource Str_AuthLabel}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource ThemeForeground}" />

                <!-- Password -->
                <TextBlock Text="{DynamicResource Str_PasswordLabel}" Margin="0,0,0,3" Foreground="{DynamicResource ThemeForeground}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordBoxControl" Grid.Column="0" PasswordChanged="PasswordBox_PasswordChanged" />
                    <TextBox x:Name="PasswordRevealBox" Grid.Column="0" Visibility="Collapsed" TextChanged="PasswordRevealBox_TextChanged" />
                    <Button Grid.Column="1" Content="👁" Width="30" Margin="4,0,0,0" Click="TogglePasswordVisibility_Click"
                            Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>

                <!-- Hiển thị khi đang sửa và đã có mật khẩu lưu -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding HasStoredPassword, Converter={x:Static vm:SessionListViewModel.BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Str_UsingSavedPassword}" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="11" VerticalAlignment="Center" />
                    <Button Content="{DynamicResource Str_ClearSavedPassword}" Command="{Binding ClearStoredPasswordActionCommand}" Margin="8,0,0,0" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#D92D20" Cursor="Hand" />
                </StackPanel>

                <CheckBox Content="{DynamicResource Str_SavePassword}" IsChecked="{Binding SavePassword}" Margin="0,0,0,6" />

                <!-- Key file -->
                <TextBlock Text="{DynamicResource Str_KeyFileLabel}" Margin="0,0,0,3" Foreground="{DynamicResource ThemeForeground}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding KeyFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Chọn..." Margin="4,0,0,0" Padding="10,4" Click="BrowseKeyFile_Click"
                            Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>
                <TextBlock Text="{Binding KeyFileWarning}" Foreground="#F79009" FontSize="11" Margin="0,0,0,6"
                           Visibility="{Binding KeyFileWarning, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}" />

                <!-- Passphrase -->
                <TextBlock Text="Passphrase key:" Margin="0,0,0,3" Foreground="{DynamicResource ThemeForeground}" />
                <PasswordBox x:Name="PassphraseBoxControl" PasswordChanged="PassphraseBox_PasswordChanged" Margin="0,0,0,6" />
            </StackPanel>
        </ScrollViewer>

        <!-- Nút hành động cố định ở đáy -->
        <Border Grid.Row="1" Padding="0,10,0,0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Kiểm tra kết nối" IsEnabled="{Binding CanTestConnection}" Padding="10,5"
                        Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Command="{Binding TestConnectionCommand}" />

                <Button Grid.Column="2" Content="{DynamicResource Str_SaveAndConnect}" IsDefault="True" Command="{Binding SaveAndCloseCommand}" CommandParameter="{x:Static vm:SessionListViewModel.TrueBox}" Margin="0,0,6,0" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="3" Content="{DynamicResource Str_Save}" Command="{Binding SaveAndCloseCommand}" CommandParameter="{x:Static vm:SessionListViewModel.FalseBox}" Padding="12,5" Margin="0,0,6,0"
                        Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" FontWeight="SemiBold" Cursor="Hand" />
                <Button Grid.Column="4" Content="{DynamicResource Str_Cancel}" IsCancel="True" Command="{Binding CancelCommand}" Padding="12,5"
                        Background="Transparent" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</Window>
