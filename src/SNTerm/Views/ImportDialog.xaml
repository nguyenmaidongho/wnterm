<Window x:Class="SNTerm.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import danh sách VM"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thông tin file -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="FileSummaryBlock" Text="File: backup.snterm (N VM)" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,4" />
                <TextBlock x:Name="ProtectionStatusBlock" Text="Không có mật khẩu bảo vệ" Foreground="#475467" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Ô nhập mật khẩu nếu có bảo vệ -->
        <Border x:Name="PasswordPanel" Grid.Row="1" Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="File này được bảo vệ bằng mật khẩu Export:" FontWeight="SemiBold" Foreground="#B42318" Margin="0,0,0,4" />
                <PasswordBox x:Name="ExportPasswordBox" Padding="6,4" />
            </StackPanel>
        </Border>

        <!-- Xử lý trùng lặp -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Khi phát hiện VM trùng (cùng host/user/port hoặc ID):" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,8" />
                <RadioButton x:Name="ConflictSkipRadio" Content="Bỏ qua (giữ nguyên VM hiện tại)" IsChecked="True" Margin="0,0,0,6" />
                <RadioButton x:Name="ConflictOverwriteRadio" Content="Ghi đè (cập nhật thông tin từ file import)" Margin="0,0,0,6" />
                <RadioButton x:Name="ConflictAddCopyRadio" Content="Thêm bản sao (tạo VM mới với đuôi '(nhập)')" />
            </StackPanel>
        </Border>

        <!-- Nút Import / Hủy -->
        <Border Grid.Row="3" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Import" Click="Import_Click" IsDefault="True" Padding="14,6" Margin="0,0,8,0" Background="#1570EF" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                <Button Content="Hủy" Click="Cancel_Click" Padding="14,6" Background="Transparent" BorderBrush="#D0D5DD" Cursor="Hand" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
