<Window x:Class="SNTerm.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_ImportTitle}"
        Icon="/Assets/favicon.png"
        Width="500" Height="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ThemeWindowBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thông tin file -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileSummaryBlock" Text="File: backup.snterm" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProtectionStatusBlock" Text="Không có mật khẩu bảo vệ" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Str_BrowseBtn}" Click="BrowseFile_Click" VerticalAlignment="Center" Margin="8,0,0,0" Padding="12,5" Style="{StaticResource ToolbarButtonStyle}" />
            </Grid>
        </Border>

        <!-- Ô nhập mật khẩu nếu có bảo vệ -->
        <Border x:Name="PasswordPanel" Grid.Row="1" Background="{DynamicResource ThemeSidebarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="File này được bảo vệ bằng mật khẩu Export:" FontWeight="SemiBold" Foreground="#F04438" Margin="0,0,0,6" />
                <PasswordBox x:Name="ExportPasswordBox" Padding="6,4" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" />
            </StackPanel>
        </Border>

        <!-- Xử lý trùng lặp -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSidebarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_ConflictHeader}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,10" />
                <RadioButton x:Name="ConflictSkipRadio" Content="{DynamicResource Str_ConflictSkip}" Foreground="{DynamicResource ThemeForeground}" IsChecked="True" Margin="0,0,0,6" />
                <RadioButton x:Name="ConflictOverwriteRadio" Content="{DynamicResource Str_ConflictOverwrite}" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,6" />
                <RadioButton x:Name="ConflictAddCopyRadio" Content="{DynamicResource Str_ConflictAddCopy}" Foreground="{DynamicResource ThemeForeground}" />
            </StackPanel>
        </Border>

        <!-- Nút Import / Hủy -->
        <Border Grid.Row="3" Padding="0,16,0,0">
            <Grid>
                <Button Content="{DynamicResource Str_ScanMobaBtn}" Click="ScanMobaXterm_Click" HorizontalAlignment="Left" Padding="12,6" Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource Str_ScanMobaTooltip}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Str_ImportAction}" Click="Import_Click" IsDefault="True" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" Padding="16,6" Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>