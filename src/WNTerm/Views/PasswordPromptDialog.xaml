<Window x:Class="WNTerm.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập mật khẩu SSH"
        Icon="/Assets/favicon.png"
        Width="440" Height="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ThemeWindowBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleBlock" Text="Nhập mật khẩu SSH" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" />
            <TextBlock x:Name="SubtitleBlock" Text="user@host:22" Foreground="{DynamicResource ThemeForegroundMuted}" />
            <TextBlock x:Name="WarningBlock" Text="Mật khẩu đã lưu không còn đúng, hãy nhập mật khẩu mới." Foreground="#F04438" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Mật khẩu:" Margin="0,0,0,4" Foreground="{DynamicResource ThemeForeground}" />
            <PasswordBox x:Name="PasswordBoxControl" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" CaretBrush="{DynamicResource ThemeForeground}" />
            <CheckBox x:Name="SavePasswordCheckBox" Content="{DynamicResource Str_SavePasswordCheck}" Foreground="{DynamicResource ThemeForeground}" IsChecked="True" />
        </StackPanel>

        <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đăng nhập" Click="Login_Click" IsDefault="True" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" IsCancel="True" Padding="14,6" Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>