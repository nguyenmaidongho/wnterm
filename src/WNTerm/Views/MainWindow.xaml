<Window x:Class="WNTerm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WNTerm.ViewModels"
        xmlns:localViews="clr-namespace:WNTerm.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Assets/favicon.png"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ThemeWindowBackground}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="ToolbarBackground" Color="#F8F9FA" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TerminalBackground" Color="#1E1E1E" />

        <!-- Toolbar Connect Button Style (Primary) -->
        <Style x:Key="ConnectToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource ThemeConnectButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeConnectButtonForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeConnectButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeConnectButtonHoverBackground}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeConnectButtonHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeConnectButtonActiveBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Tab Close Button Style -->
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4C5058" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Add Button Style -->
        <Style x:Key="TabAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#32353A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Thanh công cụ phía trên -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="White" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" ToolTip="WebNow - WN Term">
                    <Image Source="/Assets/webnow-logo.png" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ConnectSelectedVmCommand}" Style="{StaticResource ConnectToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 3 2 L 13 8 L 3 14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Connect}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddVmCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 1 L 7 13 M 1 7 L 13 7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_AddVm}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 9 L 7 1 M 3.5 4.5 L 7 1 L 10.5 4.5 M 2 13 L 12 13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Export}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 1 L 7 9 M 3.5 5.5 L 7 9 L 10.5 5.5 M 2 13 L 12 13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Import}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="14" Height="14" VerticalAlignment="Center">
                            <Line X1="1" Y1="3" X2="13" Y2="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="7.5" Canvas.Top="1.5" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Line X1="1" Y1="7" X2="13" Y2="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="3.5" Canvas.Top="5.5" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Line X1="1" Y1="11" X2="13" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="9" Canvas.Top="9.5" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                        <TextBlock Text="{DynamicResource Str_Settings}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nội dung chính 2 cột chia bằng GridSplitter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="400" MinWidth="140" MaxWidth="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: TabControl Sessions / SFTP -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectedIndex="{Binding SelectedLeftTabIndex}" BorderThickness="0" Background="Transparent">
                    <!-- Tab Sessions -->
                    <TabItem Header="{DynamicResource Str_Sessions}" FontWeight="SemiBold">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Ô tìm kiếm -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SessionList.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" MinWidth="96" MaxWidth="140"
                                          ToolTip="{DynamicResource Str_TagFilterTooltip}"
                                          ItemsSource="{Binding SessionList.TagFilterOptions}"
                                          SelectedItem="{Binding SessionList.SelectedTagFilter}" />
                            </Grid>
                            <ListBox x:Name="SessionsListBox" Grid.Row="1"
                                     ItemsSource="{Binding SessionList.SessionsView}"
                                     SelectedItem="{Binding SessionList.SelectedSession}"
                                     SelectionMode="Extended"
                                     BorderThickness="0" Background="Transparent"
                                     MouseDoubleClick="SessionsListBox_MouseDoubleClick"
                                     KeyDown="SessionsListBox_KeyDown"
                                     ContextMenuOpening="SessionsListBox_ContextMenuOpening">

                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Str_ConnectMenu}" Click="ContextMenuConnect_Click" />
                                        <MenuItem Header="{DynamicResource Str_EditVm}" Click="ContextMenuEdit_Click" InputGestureText="F2" />
                                        <MenuItem Header="{DynamicResource Str_ExportVm}" Click="ContextMenuExport_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Str_Delete}" Click="ContextMenuDelete_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>


                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
                                        <Setter Property="Padding" Value="8,7" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="true">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeItemHover}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonHoverForeground}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeItemSelected}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonHoverForeground}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon máy chủ trước tên VM: đổi màu theo trạng thái kết nối
                                                 (xanh = đang kết nối, vàng = đang kết nối/reconnect, xám = chưa kết nối) -->
                                            <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="14" Height="10" CornerRadius="1.5" BorderThickness="1.3"
                                                            BorderBrush="{Binding LiveStatus, Converter={x:Static vm:SessionListViewModel.LiveStatusToIconBrushConverter}}"
                                                            Background="Transparent" />
                                                    <Rectangle Width="3" Height="2" Fill="{Binding LiveStatus, Converter={x:Static vm:SessionListViewModel.LiveStatusToIconBrushConverter}}" HorizontalAlignment="Center" />
                                                    <Rectangle Width="9" Height="1.3" RadiusX="0.6" RadiusY="0.6" Fill="{Binding LiveStatus, Converter={x:Static vm:SessionListViewModel.LiveStatusToIconBrushConverter}}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Tên VM (đậm) + user@host (mờ, nhỏ hơn) bên dưới để phân cấp rõ ràng -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeForeground}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource ThemeForegroundMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,3,0,0"
                                                              Visibility="{Binding Tags.Count, Converter={x:Static vm:SessionListViewModel.CountToVisibilityConverter}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="8" Padding="6,0" Margin="0,0,4,2" Background="#33C42030" BorderBrush="#66C42030" BorderThickness="1">
                                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource ThemeForeground}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Biểu tượng cảnh báo thiếu file key -->
                                            <TextBlock Grid.Column="2" Text="⚠" Foreground="#F79009" FontWeight="Bold" ToolTip="{DynamicResource Str_MissingKeyTooltip}"
                                                       Visibility="{Binding IsKeyFileMissing, Converter={x:Static vm:SessionListViewModel.BoolToVisibilityConverter}}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>


                            </ListBox>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SessionList.Sessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{DynamicResource Str_NoVmsYet}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" /><TextBlock Text="{DynamicResource Str_ClickAddVm}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeForegroundMuted}" /></StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab SFTP -->
                    <TabItem Header="{DynamicResource Str_Sftp}" FontWeight="SemiBold">
                        <Grid>
                            <ContentControl Content="{Binding CurrentSftp}">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:SftpViewModel}">
                                        <localViews:SftpPanel />
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>

                            <TextBlock Text="{DynamicResource Str_NoVmConnected}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundMuted}" FontStyle="Italic"
                                       Visibility="{Binding CurrentSftp, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSftp}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Thanh chia cột có thể kéo thả -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorderBrush}" Cursor="SizeWE" ShowsPreview="True" />

            <!-- Cột phải: Thanh tab ngang và vùng Terminal -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Thanh tab ngang phía trên -->
                <Border Grid.Row="0" Background="#2B2D30" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TabBorder" Margin="2,0,2,0" Padding="10,6" CornerRadius="6,6,0,0"
                                                    Cursor="Hand" ToolTip="{Binding TooltipText}"
                                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                                    MouseDown="Tab_MouseDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#32353A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1E1E1E" />
                                                                <Setter Property="BorderBrush" Value="#3C3F41" />
                                                                <Setter Property="BorderThickness" Value="1,1,1,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="● " Foreground="{Binding StatusBrush}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Title}" Foreground="#E6EDF3" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <Button Content="×" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource TabCloseButtonStyle}" />
                                                </StackPanel>

                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource Str_Reconnect}" Command="{Binding ReconnectCommand}" />
                                                        <MenuItem Header="{DynamicResource Str_DuplicateTab}" Command="{Binding DataContext.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Str_CloseTab}" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Str_CloseOtherTabs}" Command="{Binding DataContext.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Str_CloseRightTabs}" Command="{Binding DataContext.CloseRightTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Str_CloseAllTabs}" Command="{Binding DataContext.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Nút thêm tab [+] -->
                                <Button Content="+" Command="{Binding OpenVmListCommand}" Width="28" Height="28" Margin="4,0,4,2" Style="{StaticResource TabAddButtonStyle}" ToolTip="{DynamicResource Str_OpenVmListTooltip}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Vùng chứa Terminal (xterm.js WebView2) -->
                <Border Grid.Row="1" Background="{StaticResource TerminalBackground}">
                    <Grid>
                        <!-- Container cho các WebView2 của các tab -->
                        <Grid x:Name="TerminalContainerGrid" />

                        <!-- Placeholder khi chưa có tab nào -->
                        <TextBlock Text="{DynamicResource Str_TerminalPlaceholder}"
                                   Foreground="#8B949E" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding Tabs.Count, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Thanh trạng thái phía dưới -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeStatusBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>


