<Window x:Class="WNTerm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WNTerm.ViewModels"
        xmlns:localViews="clr-namespace:WNTerm.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Assets/favicon.png"
        Width="1155" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource ThemeWindowBackground}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D5DD" />
        <SolidColorBrush x:Key="ToolbarBackground" Color="#F8F9FA" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TerminalBackground" Color="#1E1E1E" />

        <!-- Toolbar Connect Button Style (Primary) -->
        <Style x:Key="ConnectToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource ThemeConnectButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeConnectButtonForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeConnectButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeConnectButtonHoverBackground}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeConnectButtonHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeConnectButtonActiveBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Tab Close Button Style -->
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4C5058" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Add Button Style -->
        <Style x:Key="TabAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#32353A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="11" BorderThickness="1" Background="Transparent"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ThemeItemHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33C42030" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#88C42030" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ThemeButtonHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Thanh công cụ phía trên -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="White" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" ToolTip="WebNow - WN Term">
                    <Image Source="/Assets/webnow-logo.png" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ConnectSelectedVmCommand}" Style="{StaticResource ConnectToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 3 2 L 13 8 L 3 14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Connect}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddVmCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 1 L 7 13 M 1 7 L 13 7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_AddVm}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 9 L 7 1 M 3.5 4.5 L 7 1 L 10.5 4.5 M 2 13 L 12 13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Export}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 1 L 7 9 M 3.5 5.5 L 7 9 L 10.5 5.5 M 2 13 L 12 13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Import}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenCloudBackupCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 4 12 A 3 3 0 0 1 4.5 6 A 4 4 0 0 1 12 5.5 A 3 3 0 0 1 12 12 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="16" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Cloud" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OpenPalette_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Ctrl+K">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_QuickFind}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="14" Height="14" VerticalAlignment="Center">
                            <Line X1="1" Y1="3" X2="13" Y2="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="7.5" Canvas.Top="1.5" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Line X1="1" Y1="7" X2="13" Y2="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="3.5" Canvas.Top="5.5" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Line X1="1" Y1="11" X2="13" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="9" Canvas.Top="9.5" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                        <TextBlock Text="{DynamicResource Str_Settings}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nội dung chính 2 cột chia bằng GridSplitter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="400" MinWidth="140" MaxWidth="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: TabControl Sessions / SFTP -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,0">
                <TabControl x:Name="LeftTabControl" SelectedIndex="{Binding SelectedLeftTabIndex}" BorderThickness="0" Background="Transparent">
                    <!-- Tab Sessions -->
                    <TabItem Header="{DynamicResource Str_Sessions}" FontWeight="SemiBold">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Ô tìm kiếm -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SessionList.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Padding="9,0" Click="OpenPalette_Click" ToolTip="{DynamicResource Str_QuickFindTip}"
                                        Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForegroundMuted}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand">
                                    <TextBlock Text="Ctrl+K" FontSize="11" />
                                </Button>
                            </Grid>
                            <!-- Chip lọc tag -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="{DynamicResource Str_AllChip}" Command="{Binding SessionList.ClearTagFilterCommand}"
                                                  IsChecked="{Binding SessionList.HasNoActiveTag, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{Binding SessionList.TagChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="{Binding Label}" IsChecked="{Binding IsActive, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ChipToggleStyle}" Margin="4,0,0,4" Content="{DynamicResource Str_GroupChip}" ToolTip="{DynamicResource Str_GroupChipTip}"
                                              IsChecked="{Binding SessionList.IsGrouped, Mode=TwoWay}" />
                            </Grid>
                            <ListBox x:Name="SessionsListBox" Grid.Row="2"
                                     ItemsSource="{Binding SessionList.SessionsView}"
                                     SelectedItem="{Binding SessionList.SelectedSession}"
                                     SelectionMode="Extended"
                                     BorderThickness="0" Background="Transparent"
                                     MouseDoubleClick="SessionsListBox_MouseDoubleClick"
                                     KeyDown="SessionsListBox_KeyDown"
                                     ContextMenuOpening="SessionsListBox_ContextMenuOpening">

                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Str_ConnectMenu}" Click="ContextMenuConnect_Click" />
                                        <MenuItem Header="{DynamicResource Str_EditVm}" Click="ContextMenuEdit_Click" InputGestureText="F2" />
                                        <MenuItem Header="{DynamicResource Str_PinToggle}" Click="ContextMenuPin_Click" />
                                        <MenuItem Header="{DynamicResource Str_ExportVm}" Click="ContextMenuExport_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Str_Delete}" Click="ContextMenuDelete_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>


                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
                                        <Setter Property="Padding" Value="8,7" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="true">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeItemHover}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonHoverForeground}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeItemSelected}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonHoverForeground}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <StackPanel>
                                                                <ToggleButton x:Name="Hdr" IsChecked="True" Cursor="Hand" Loaded="GroupHeader_Loaded" Click="GroupHeader_Click" Tag="{Binding Name}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,1" Padding="8,5" Margin="0,4,0,0">
                                                                                <ContentPresenter />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="16" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundMuted}"
                                                                                   Text="&#xE70D;">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                                                            <Setter Property="Text" Value="&#xE76C;" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundMuted}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Items, Converter={x:Static vm:SessionListViewModel.GroupHeaderConverter}}" FontSize="11" Foreground="{DynamicResource ThemeForegroundMuted}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </ToggleButton>
                                                                <ItemsPresenter x:Name="Items" />
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger SourceName="Hdr" Property="IsChecked" Value="False">
                                                                    <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1" Background="Transparent" ToolTip="{Binding TagsText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon máy chủ (màu theo kết nối đang mở) + chấm online/offline -->
                                            <Grid Grid.Column="0" Width="20" Height="20" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="14" Height="10" CornerRadius="1.5" BorderThickness="1.3"
                                                            BorderBrush="{Binding LiveStatus, Converter={x:Static vm:SessionListViewModel.LiveStatusToIconBrushConverter}}"
                                                            Background="Transparent" />
                                                    <Rectangle Width="3" Height="2" Fill="{Binding LiveStatus, Converter={x:Static vm:SessionListViewModel.LiveStatusToIconBrushConverter}}" HorizontalAlignment="Center" />
                                                    <Rectangle Width="9" Height="1.3" RadiusX="0.6" RadiusY="0.6" Fill="{Binding LiveStatus, Converter={x:Static vm:SessionListViewModel.LiveStatusToIconBrushConverter}}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Fill="{Binding IsOnline, Converter={x:Static vm:SessionListViewModel.OnlineToBrushConverter}}"
                                                         Stroke="{DynamicResource ThemeSidebarBackground}" StrokeThickness="1.2" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#F5A623" VerticalAlignment="Center" Margin="0,0,4,0"
                                                               Visibility="{Binding IsPinned, Converter={x:Static vm:SessionListViewModel.BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeForeground}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource ThemeForegroundMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Ping + lần kết nối gần nhất (ẩn khi rê chuột) -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding PingText}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeForegroundMuted}" />
                                                <TextBlock Text="{Binding LastConnectedText}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeForegroundMuted}" Opacity="0.75" />
                                            </StackPanel>

                                            <!-- Thao tác nhanh khi rê chuột -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" Visibility="Collapsed">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Content="&#xE768;" ToolTip="{DynamicResource Str_QaConnect}" Click="QuickConnect_Click" />
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Content="&#xE8B7;" ToolTip="{DynamicResource Str_QaSftp}" Click="QuickSftp_Click" />
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Content="&#xE8C8;" ToolTip="{DynamicResource Str_QaCopy}" Click="QuickCopy_Click" />
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Content="&#xE70F;" ToolTip="{DynamicResource Str_QaEdit}" Click="QuickEdit_Click" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="⚠" Foreground="#F79009" FontWeight="Bold" ToolTip="{DynamicResource Str_MissingKeyTooltip}"
                                                       Visibility="{Binding IsKeyFileMissing, Converter={x:Static vm:SessionListViewModel.BoolToVisibilityConverter}}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>


                            </ListBox>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SessionList.Sessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{DynamicResource Str_NoVmsYet}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4" /><TextBlock Text="{DynamicResource Str_ClickAddVm}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeForegroundMuted}" /></StackPanel>
                            <!-- Thanh tóm tắt / thao tác theo ngữ cảnh -->
                            <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,5" CornerRadius="6" Background="{DynamicResource ThemeToolbarBackground}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Command="{Binding SessionList.ConnectAllWithTagCommand}" Padding="8,1" FontSize="11" Cursor="Hand"
                                            Background="{DynamicResource ThemeButtonBackground}" Foreground="{DynamicResource ThemeForeground}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            Visibility="{Binding SessionList.TagForGroupAction, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}">
                                        <TextBlock FontSize="11">
                                            <Run Text="{DynamicResource Str_OpenAllTag}" /><Run Text="{Binding SessionList.TagForGroupAction, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </Button>
                                    <TextBlock Text="{Binding SessionList.SummaryText}" FontSize="11" Foreground="{DynamicResource ThemeForegroundMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab SFTP -->
                    <TabItem Header="{DynamicResource Str_Sftp}" FontWeight="SemiBold">
                        <Grid>
                            <ContentControl Content="{Binding CurrentSftp}">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:SftpViewModel}">
                                        <localViews:SftpPanel />
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>

                            <TextBlock Text="{DynamicResource Str_NoVmConnected}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundMuted}" FontStyle="Italic"
                                       Visibility="{Binding CurrentSftp, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSftp}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Thanh chia cột có thể kéo thả -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorderBrush}" Cursor="SizeWE" ShowsPreview="True" />

            <!-- Cột phải: Thanh tab ngang và vùng Terminal -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Thanh tab ngang phía trên -->
                <Border Grid.Row="0" Background="#2B2D30" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TabBorder" Margin="2,0,2,0" Padding="10,6" CornerRadius="6,6,0,0"
                                                    Cursor="Hand" ToolTip="{Binding TooltipText}"
                                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                                    MouseDown="Tab_MouseDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#32353A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1E1E1E" />
                                                                <Setter Property="BorderBrush" Value="#3C3F41" />
                                                                <Setter Property="BorderThickness" Value="1,1,1,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="● " Foreground="{Binding StatusBrush}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Title}" Foreground="#E6EDF3" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <Button Content="×" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource TabCloseButtonStyle}" />
                                                </StackPanel>

                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource Str_Reconnect}" Command="{Binding ReconnectCommand}" />
                                                        <MenuItem Header="{DynamicResource Str_DuplicateTab}" Command="{Binding DataContext.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Str_CloseTab}" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Str_CloseOtherTabs}" Command="{Binding DataContext.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Str_CloseRightTabs}" Command="{Binding DataContext.CloseRightTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{DynamicResource Str_CloseAllTabs}" Command="{Binding DataContext.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Nút thêm tab [+] -->
                                <Button Content="+" Command="{Binding OpenVmListCommand}" Width="28" Height="28" Margin="4,0,4,2" Style="{StaticResource TabAddButtonStyle}" ToolTip="{DynamicResource Str_OpenVmListTooltip}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Vùng chứa Terminal (xterm.js WebView2) -->
                <Border Grid.Row="1" Background="{StaticResource TerminalBackground}">
                    <Grid>
                        <!-- Container cho các WebView2 của các tab -->
                        <Grid x:Name="TerminalContainerGrid" />

                        <!-- Placeholder khi chưa có tab nào -->
                        <TextBlock Text="{DynamicResource Str_TerminalPlaceholder}"
                                   Foreground="#8B949E" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding Tabs.Count, Converter={x:Static vm:SessionListViewModel.NullToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Thanh trạng thái phía dưới -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeStatusBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeForegroundMuted}" FontSize="12" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>


